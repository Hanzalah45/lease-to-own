# Loaded by `next build` (Vercel sets NODE_ENV=production), NOT by `next dev`.
# Local development keeps using the localhost fallback in src/lib/api.ts, so
# running the app locally can never hit the live Hostinger database.
#
# Not a secret: NEXT_PUBLIC_* values are inlined into the browser bundle by
# design, and this is a public API base URL. A Vercel dashboard environment
# variable of the same name overrides this file if one is ever set.
NEXT_PUBLIC_API_URL=https://blue-pheasant-283511.hostingersite.com/api
