# Loaded by `next build` when NODE_ENV=production, NOT by `next dev`.
#
# Relative on purpose: the browser calls /api on prostartleasing.com itself.
# In production Nginx routes that straight to Laravel (frontend and backend
# run side by side on the same server), so no cross-origin request ever
# happens and the backend's CORS allow-list never comes into play. Putting
# the backend's absolute URL here instead would send the browser straight at
# Laravel and reintroduce CORS for no reason.
#
# Local development ignores this file and uses the http://localhost:8000/api
# fallback in src/lib/api.ts, so running locally never touches the live server.
NEXT_PUBLIC_API_URL=/api

# Stripe's publishable key is meant to be public — safe to commit, unlike the
# secret key (which lives only in the backend's .env). Test mode for now;
# swap for the live pk_live_... key together with the backend's STRIPE_SECRET
# once AutoPay charging itself goes live.
NEXT_PUBLIC_STRIPE_KEY=pk_test_51UBLUU2SIYmuE9oyXxxi3bpXLvicy4x7CPKj3bZ7EpvJQiwM4dYojTDaUijtZbYIcoLiSHlE5S4Y9WYJBeXbsC0p0023mV9YoI
